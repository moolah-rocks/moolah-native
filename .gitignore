.env
project-entitlements.yml

# Xcode
*.xcodeproj
*.xcworkspace
xcuserdata/
*.xccheckout
*.moved-aside
DerivedData/
.DerivedData*/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcarchive

# Swift Package Manager
.build/
build/
.swiftpm/

# Worktrees
.worktrees/
.claude/worktrees/
.claude/scheduled_tasks.lock

# CloudKit wire structs generated by tools/CKDBSchemaGen from CloudKit/schema.ckdb.
# Regenerated by `just generate`. Never edit by hand.
Backends/CloudKit/Sync/Generated/

# Superpowers skill state
.superpowers/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output
fastlane/api_key.json
vendor/bundle

# Agent temp files (test output, etc.)
.agent-tmp/

# Help Book bundle generated by tools/HelpGen from Help/ source tree.
# Regenerated by `just generate` / `just build-help`. Never edit by hand.
Help/Build/

# Hand-staged copy of the built macOS app at the repo root. The build
# artefact lives under .build/; this copy exists only to run a fully-
# Spotlight-indexed instance (helpd doesn't index .build/). Local-only.
/Moolah.app/

# macOS
.DS_Store
*.swp
